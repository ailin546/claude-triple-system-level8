{
  "schema_version": 1,
  "system": {
    "name": "Claude + Codex Unified Workflow",
    "architecture": "shared-semantic-kernel-native-adapters",
    "invariants": [
      "Fast, Standard, and Heavy have the same intent on every client",
      "completion claims require fresh verification evidence",
      "Claude and Codex read and write the same memory paths",
      "client runtime state, hook locks, transcripts, and caches stay isolated",
      "Claude runtime behavior may change only through an explicit compatibility review",
      "Superpowers plugin entrypoints are inactive on both clients"
    ]
  },
  "memory_protocol": "shared/memory/PROTOCOL.md",
  "codex": {
    "agents_source": "shared/workflow/adapters/codex/AGENTS.md",
    "agents_output": "adapters/codex/AGENTS.md",
